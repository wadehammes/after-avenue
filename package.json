{
  "name": "next-after-avenue",
  "version": "0.0.0",
  "packageManager": "pnpm@12.16.1",
  "private": true,
  "scripts": {
    "scaffold": "bash scripts/scaffold.sh",
    "dev": "NODE_OPTIONS='--inspect' next dev -p 3005",
    "dev:webpack": "NODE_OPTIONS='--inspect' next dev -p 3005 --webpack",
    "email:dev": "email dev --dir src/emails --port 3006",
    "build": "next build && make sitemap",
    "build:webpack": "next build --webpack && make sitemap",
    "build:analyze": "next experimental-analyze && make sitemap",
    "build:analyze:legacy": "ANALYZE=true next build --webpack && make sitemap",
    "start": "next start -p 3005",
    "export": "next export",
    "tsc:ci": "tsc --strict",
    "lint": "biome check",
    "lint:ci": "biome ci --reporter=github",
    "lint:fix": "biome check --fix",
    "lint:changed": "biome check --changed --since origin/staging --no-errors-on-unmatched --verbose --write --diagnostic-level=error",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "lint:all": "pnpm lint:changed && pnpm lint:css:fix && pnpm tsc:ci && pnpm knip:ci",
    "format": "biome format --write .",
    "test:ci": "jest --passWithNoTests",
    "types:contentful": "export $(cat .env.local | sed '/^#/d; s/[$\"]//g'); cf-content-types-generator -s $CONTENTFUL_SPACE_ID -t $CONTENTFUL_CMA_TOKEN -o src/contentful/types -r -g && biome format --write src/contentful/types",
    "knip": "knip",
    "knip:ci": "knip --no-progress",
    "handbook:check": "bash scripts/handbook-sync-check.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@contentful/rich-text-plain-text-renderer": "^17.2.1",
    "@contentful/rich-text-react-renderer": "^16.2.2",
    "@contentful/rich-text-types": "^17.2.7",
    "@hookform/resolvers": "^6.0.2",
    "@jest/types": "^30.5.1",
    "@next/third-parties": "^16.4.3",
    "@svgr/webpack": "^8.1.0",
    "@tanstack/react-query": "^5.105.0",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "contentful": "^11.12.10",
    "html-react-parser": "^6.1.9",
    "next": "^16.4.3",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-preset-env": "^11.6.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.5",
    "react-google-recaptcha": "^3.1.0",
    "react-hook-form": "^7.91.0",
    "react-intersection-observer": "^11.0.1",
    "react-player": "^3.4.0",
    "resend": "6.35.0",
    "safe-json-stringify": "^1.2.0",
    "schema-dts": "^2.1.0",
    "tslib": "^2.8.1",
    "usehooks-ts": "^3.1.1",
    "vimeo-video-element": "^1.7.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@faker-js/faker": "^10.6.0",
    "@jest/globals": "^30.5.2",
    "@react-email/ui": "^6.11.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-google-recaptcha": "^2.1.9",
    "@types/safe-json-stringify": "^1.1.5",
    "cf-content-types-generator": "^3.0.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "knip": "^6.43.0",
    "stylelint": "^18.0.0-next.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-standard": "^41.0.0-next.0",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "ts-jest": "^29.4.15",
    "typescript": "^7.0.2",
    "typescript-langservice": "npm:typescript@6.0.3",
    "typescript-plugin-css-modules": "^5.3.0",
    "webpack-bundle-analyzer": "^5.4.0"
  }
}
